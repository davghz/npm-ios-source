#!/bin/sh
# iOS runtime wrapper used on iPhone X (iOS 13.2.3)
NODE_ARGS="--max-opt=0 --no-sparkplug --max-old-space-size=512 --disable-wasm-trap-handler"
attempt=1
while [ "$attempt" -le 5 ]; do
  /usr/local/bin/node22 $NODE_ARGS /usr/local/lib/node22/node_modules/npm/bin/npx-cli.js "$@"
  rc=$?
  case "$rc" in
    134|137|138) ;;
    *) exit "$rc" ;;
  esac
  attempt=$((attempt + 1))
  sleep 0.3
done
exit "$rc"
